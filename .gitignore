*netrwhist
*.bck

mpd/.mpd/state
zsh/.zsh/.zcompdump
zsh/.zsh_abbr_user

.idea/**/*

# zunit test output
tests/_output/*
!tests/_output/.gitkeep

# nix build output symlink
/result

# python bytecode cache
__pycache__/

# The generated bookmark tree is committed on purpose: it doubles as a
# versioned backup, and `git diff` on it previews what a Firefox Restore
# would change. Overrides the global `build/` rule in ~/.config/git/ignore.
# The directory must be re-included first -- git will not descend into an
# excluded directory, so negating only the file would have no effect.
!bookmarks/build/
!bookmarks/build/bookmarks.json
