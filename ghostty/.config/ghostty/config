# Ghostty Configuration

# Window
window-height = 30
window-width = 120
window-padding-balance = true
window-padding-x = 12
window-padding-y = 8
window-inherit-working-directory = true
window-theme = dark
window-decoration = false
window-save-state = always

# Theme and Appearance
